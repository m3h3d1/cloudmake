    print(
        f"{'BACKEND':22} {'STATUS':11} {'SESSION REUSE':13} {'LIFECYCLE':18} "
        f"{'WORKSPACE':17} {'OCI NATIVE':10} {'PERSISTENCE':12} "
        f"{'TRANSPORT':36} {'OCI RUNTIMES':34} {'INTERNET IN':12} "
        f"{'INTERNET OUT':12} {'DEVCONTAINER':12} {'DC ENGINE':14} {'PORTS':10} HOST CLIENT"
    )
    for name, (session_reuse, transport, client) in BACKENDS.items():
        installed = "found" if shutil.which(client) else "missing"
        status, _ = backend_status(name)
        runtimes = backend_oci_runtimes(name)
        oci_native = backend_oci_native(name)
        runtime_text = (
            "provider-native"
            if oci_native
            else ",".join(runtimes) if runtimes else "unsupported"
        )
        lifecycle = backend_declaration(name, "BACKEND_LIFECYCLE_CONTROL")
        workspace = backend_declaration(name, "BACKEND_WORKSPACE_DURABILITY")
        internet_in = backend_declaration(name, "BACKEND_INTERNET_INBOUND")
