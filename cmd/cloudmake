def backend_declaration(backend: str, name: str) -> str:
    path = TOOL_ROOT / "backend" / backend / "backend.mk"
    try:
        source = path.read_text(encoding="utf-8")
    except OSError as error:
        raise UsageError(f"cannot read backend definition {path}: {error}") from error
    match = re.search(
        rf"^{re.escape(name)}\s*:?=\s*([^#\n]*?)\s*$", source, re.MULTILINE
    )
    if match is None:
        raise UsageError(f"backend {backend!r} does not declare {name}")
    return match.group(1).strip()


def optional_backend_declaration(backend: str, name: str, default: str) -> str:
    path = TOOL_ROOT / "backend" / backend / "backend.mk"
    try:
        source = path.read_text(encoding="utf-8")
    except OSError as error:
        raise UsageError(f"cannot read backend definition {path}: {error}") from error
    match = re.search(
        rf"^{re.escape(name)}\s*:?=\s*([^#\n]*?)\s*$", source, re.MULTILINE
    )
    return default if match is None else match.group(1).strip()


def backend_oci_runtimes(backend: str) -> list[str]:
    values = backend_declaration(backend, "BACKEND_OCI_RUNTIMES").split()
    if values == ["none"]:
        return []
    if not values or len(values) != len(set(values)):
        raise UsageError(f"backend {backend!r} has invalid OCI runtime options")
    invalid = [value for value in values if value not in OCI_RUNTIME_CANDIDATES]
    if invalid:
        raise UsageError(
            f"backend {backend!r} has unknown OCI runtime option(s): "
            + ", ".join(invalid)
        )
    return values


def backend_oci_native(backend: str) -> bool:
    value = backend_declaration(backend, "BACKEND_OCI_NATIVE")
    if value not in {"yes", "no"}:
        raise UsageError(f"backend {backend!r} has invalid OCI-native value {value!r}")
    return value == "yes"


def backend_target_replay(backend: str) -> str:
    """Read the static replay declaration without contacting a provider."""
    descriptor = TOOL_ROOT / "backend" / backend / "backend.mk"
    declarations = [
        line
        for line in descriptor.read_text(encoding="utf-8").splitlines()
        if re.match(r"^\s*BACKEND_TARGET_REPLAY\b", line)
    ]
    if not declarations:
        return "none"
    if len(declarations) != 1:
        raise UsageError(
            f"backend {backend!r} must declare BACKEND_TARGET_REPLAY exactly once"
        )
    match = BACKEND_TARGET_REPLAY_DECLARATION.fullmatch(declarations[0])
    if match is None:
        raise UsageError(
            f"backend {backend!r} has invalid target replay declaration "
            f"{declarations[0].strip()!r}; expected 'none' or 'fenced'"
        )
    return match.group(1)


def backend_devcontainer_capabilities(backend: str, kind: str) -> set[str]:
    name = f"BACKEND_DEVCONTAINER_{kind.upper()}_CAPABILITIES"
    values = backend_declaration(backend, name).split()
    if values == ["none"]:
        return set()
    if not values or len(values) != len(set(values)):
        raise UsageError(f"backend {backend!r} has invalid {kind} Dev Container capabilities")
    unknown = set(values) - DEVCONTAINER_CAPABILITIES
    if unknown:
        raise UsageError(
            f"backend {backend!r} has unknown {kind} Dev Container capability(s): "
            + ", ".join(sorted(unknown))
        )
    return set(values)


def backend_devcontainer_realization_order(
    backend: str, adapter: set[str], native: set[str]
) -> list[str]:
    default = " ".join(
        name for name, capabilities in (("adapter", adapter), ("native", native))
        if capabilities
    ) or "none"
    values = optional_backend_declaration(
        backend, "BACKEND_DEVCONTAINER_REALIZATION_ORDER", default
    ).split()
    if values == ["none"]:
        values = []
    if (
        len(values) != len(set(values))
        or any(value not in {"adapter", "native"} for value in values)
    ):
        raise UsageError(
            f"backend {backend!r} has invalid Dev Container realization order"
        )
    expected = {
        name for name, capabilities in (("adapter", adapter), ("native", native))
        if capabilities
    }
    if set(values) != expected:
        raise UsageError(
            f"backend {backend!r} Dev Container realization order must list "
            "each declared realization exactly once"
        )
    return values


def validate_backend_devcontainer_contract(backend: str) -> tuple[set[str], set[str]]:
    """Reject internally inconsistent descriptor claims before provider contact."""
    capabilities = set(backend_declaration(backend, "BACKEND_CAPABILITIES").split())
    adapter = backend_devcontainer_capabilities(backend, "adapter")
    native = backend_devcontainer_capabilities(backend, "native")
    advertised = "devcontainer" in capabilities
    if advertised != bool(adapter or native):
        detail = (
            "declares devcontainer but no declared realization capabilities"
            if advertised
            else "declares engine capabilities without the devcontainer capability"
        )
        raise UsageError(f"backend {backend!r} {detail}")
    if adapter and "oci-runner" not in capabilities:
        raise UsageError(
            f"backend {backend!r} declares Dev Container adapter capabilities "
            "without the oci-runner capability"
        )
    if adapter and "image-digest" not in adapter:
        raise UsageError(
            f"backend {backend!r} Dev Container adapter must support image-digest"
        )
    if "forward-ports" in adapter and "port-forward" not in capabilities:
        raise UsageError(
            f"backend {backend!r} declares Dev Container forward-ports without "
            "the port-forward capability"
        )
    backend_devcontainer_realization_order(backend, adapter, native)
    return adapter, native


def backend_status(backend: str) -> tuple[str, str]:
    status = backend_declaration(backend, "BACKEND_PRODUCT_STATUS")
    if status not in {"supported", "unqualified", "deprecated"}:
        raise UsageError(f"backend {backend!r} has invalid status {status!r}")
    reason = ""
    if status != "supported":
        reason = backend_declaration(backend, "BACKEND_PRODUCT_STATUS_REASON")
        if not reason:
            raise UsageError(f"{status} backend {backend!r} has no status reason")
    return status, reason


def warn_backend_status(backend: str) -> None:
    status, reason = backend_status(backend)
    if status != "supported":
        print(
            f"[cloudmake] warning: backend={backend} status={status}; {reason}.",
            file=sys.stderr,
        )


