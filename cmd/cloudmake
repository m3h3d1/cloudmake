def detach_workspace_mappings(
    config_home: Path, workspace_id: str, *, keep: Path | None = None
) -> None:
    for path in (config_home / "projects").glob("*.json"):
        if keep is not None and path == keep:
            continue
        saved = load_json(path)
        workspace_ids = saved.get("workspace_ids", {})
        mapped = (
            isinstance(workspace_ids, dict)
            and workspace_id in workspace_ids.values()
        )
        active = saved.get("workspace_id") == workspace_id
        if not active and not mapped:
            continue
        if isinstance(workspace_ids, dict):
            for name, value in workspace_ids.items():
                if value == workspace_id and isinstance(saved.get("persistent_workspaces"), dict):
                    saved["persistent_workspaces"][name] = False
            remaining = {
                name: value for name, value in workspace_ids.items()
                if value != workspace_id
            }
            if remaining:
                saved["workspace_ids"] = remaining
            else:
                saved.pop("workspace_ids", None)
        if active:
            saved.pop("workspace_id", None)
            saved.pop("checkpoint", None)
            saved["persistent_workspace"] = False
            if isinstance(saved.get("persistent_workspaces"), dict) and saved.get("backend"):
                saved["persistent_workspaces"][saved["backend"]] = False
        pending = saved.get("workspace_adoption")
        if isinstance(pending, dict) and pending.get("workspace_id") == workspace_id:
            saved.pop("workspace_adoption", None)
        atomic_json(path, saved)


def manage_workspace(
    *,
    project: Path,
    project_id: str,
    config_home: Path,
    state_home: Path,
    cache_home: Path,
    options: dict[str, Any],
    positional: list[str],
) -> int:
    if (
        options["backend"] is not None
        or options["accelerator_set"]
        or options["checkpoint"] is not None
        or options["image"] is not None
        or options["devcontainer"] is not None
        or options["native_runner"]
        or options["devices_set"]
        or options["host"] is not None
        or options["global"]
    ):
        raise UsageError(
            "workspace management cannot be combined with backend, host, accelerator, "
            "persistence, runner, or global selection options"
        )
    operation = options["workspace_action"]
    if operation not in {"show", "attach", "purge"}:
        raise UsageError("--workspace requires one of: show, attach, purge")
    project_config = load_json(config_home / "projects" / f"{project_id}.json")
    configured_backend = canonical_backend(str(project_config.get("backend", "colab")))
    current = configured_workspace_id(project_config, project_id, configured_backend)
    if operation == "show":
        if options["force"]:
            raise UsageError("--force is not used with --workspace show")
        if len(positional) > 1:
            raise UsageError("--workspace show accepts at most one workspace ID")
        show_workspace(state_home, positional[0] if positional else current)
        return 0
    if len(positional) != 1:
        raise UsageError(f"--workspace {operation} requires one workspace ID")
    selected = positional[0]
    record = load_workspace_record(state_home, selected)
    record_backend = record.get("backend")
    if record_backend not in {"colab-notebook", "kaggle-notebook"}:
        raise UsageError("the selected backend does not provide managed checkpoints")
    if operation == "attach":
        if options["force"]:
            raise UsageError("--force is not used with --workspace attach")
        config_path = config_home / "projects" / f"{project_id}.json"
        previous_project_id = None
        if record_backend == "colab-notebook":
            previous_project_id = record.get("project_id")
            if previous_project_id is None and isinstance(record.get("last_attached_project"), str):
                previous_project_id = project_key(Path(record["last_attached_project"]))
            if (
                not isinstance(previous_project_id, str)
                or WORKSPACE_ID.fullmatch(previous_project_id) is None
            ):
                raise UsageError("persistent workspace has no known previous owner")
        detach_workspace_mappings(config_home, selected, keep=config_path)
        saved = project_config
        saved.update(
            backend=record_backend,
            persistent_workspace=True,
            checkpoint=True,
            workspace_id=selected,
            project=os.fspath(project),
        )
        remember_workspace_id(saved, record_backend, selected)
        if record_backend == "colab-notebook" and previous_project_id != project_id:
            saved["workspace_adoption"] = {
                "workspace_id": selected,
                "previous_project_id": previous_project_id,
            }
        else:
            saved.pop("workspace_adoption", None)
        saved_accelerator = record.get("accelerator")
        if isinstance(saved_accelerator, str):
            saved["accelerator"] = "" if saved_accelerator == "cpu" else saved_accelerator
        atomic_json(config_path, saved)
        update_workspace_record(
            state_home=state_home,
            workspace_id=selected,
            project=project,
            backend=record_backend,
            accelerator=(
                saved_accelerator if isinstance(saved_accelerator, str) else None
            ),
        )
        accelerator_note = (
            f" accelerator={saved_accelerator}"
            if isinstance(saved_accelerator, str) and saved_accelerator
            else " accelerator=cpu"
        )
        print(
            f"[cloudmake] attached project={project.name} to persistent-workspace={selected}; "
            f"backend={record_backend}{accelerator_note}; subsequent targets restore and update it."
        )
        return 0
    if not options["force"]:
        detail = (
            "the encrypted Drive repository and its local key"
            if record_backend == "colab-notebook"
            else "both private Kaggle checkpoint kernel slots"
        )
        raise UsageError(
            f"purging permanently deletes {detail}; rerun with --force "
            "--workspace purge WORKSPACE_ID"
        )
    purge_session = record.get("session")
    if not isinstance(purge_session, str) or not purge_session:
        purge_session = os.environ.get("COLAB_SESSION", "cuda-build")
    exit_code = engine_command(
        project=project,
        backend=record_backend,
        accelerator="",
        accelerator_set=True,
        ssh_host=None,
        jobs=options["jobs"],
        verbose=options["verbose"],
        state_home=state_home,
        cache_home=cache_home,
        key=project_id,
        workspace_id=selected,
        target="workspace-purge",
        assignments=[],
        retry_seconds=None,
        checkpoint=True,
        colab_session=purge_session if record_backend == "colab-notebook" else None,
    )
    if exit_code == 0:
        workspace_record_path(state_home, selected).unlink(missing_ok=True)
        detach_workspace_mappings(config_home, selected)
        print(f"[cloudmake] persistent-workspace={selected} purged and detached")
    return exit_code


def resolve_ssh_host(
    options: dict[str, Any], project_config: dict[str, Any], global_config: dict[str, Any]
) -> str | None:
    value: Any = options["host"]
    if value is None:
        value = os.environ.get("CLOUDMAKE_SSH_HOST") or os.environ.get("SSH_HOST")
    if value is None:
        value = project_config.get("host", global_config.get("host"))
    if value is None:
        return None
    if not isinstance(value, str) or not SSH_HOST_ALIAS.fullmatch(value):
        raise UsageError(
            "SSH host aliases must begin with a letter or number and contain only "
            "letters, numbers, dot, dash, and underscore"
        )
    return value


def resolve_codespace(config_home: Path, key: str) -> str | None:
    value: Any = os.environ.get("CODESPACE")
    if value is None:
        value = load_json(config_home / "projects" / f"{key}.json").get("codespace")
    if value is None:
        return None
    if not isinstance(value, str) or not COLAB_SESSION_NAME.fullmatch(value):
        raise UsageError(
            "Codespace names may contain only letters, numbers, dot, dash, and underscore"
        )
    return value


def resolve_gcp_resource(config_home: Path, key: str) -> dict[str, str] | None:
    """Resolve the project-local Compute Engine selection without credentials."""
    configured = load_json(config_home / "projects" / f"{key}.json").get("gcp")
    if configured is None:
        configured = {}
    if not isinstance(configured, dict):
        raise UsageError("configured GCP resource must be a JSON object")
    names = {
        "project": "GCP_PROJECT",
        "zone": "GCP_ZONE",
        "instance": "GCP_INSTANCE",
    }
    selected: dict[str, str] = {}
    for name, environment in names.items():
        value = os.environ.get(environment, configured.get(name))
        if value is not None:
            if not isinstance(value, str) or not value:
                raise UsageError(f"configured GCP {name} must be a non-empty string")
            selected[name] = value
    iap: Any = os.environ.get(
        "GCP_TUNNEL_THROUGH_IAP", configured.get("tunnel_through_iap", "no")
    )
    if iap not in {"yes", "no"}:
        raise UsageError("GCP_TUNNEL_THROUGH_IAP must be yes or no")
    selected["tunnel_through_iap"] = str(iap)
    if not any(name in selected for name in names):
        return None
    missing = [
        environment for name, environment in names.items() if name not in selected
    ]
    if missing:
        raise UsageError(
            "incomplete GCP resource selection; set " + ", ".join(missing)
        )
    patterns = {
        "project": re.compile(r"^[A-Za-z0-9._:-]+$"),
        "zone": re.compile(r"^[A-Za-z0-9-]+$"),
        "instance": re.compile(r"^[A-Za-z0-9-]+$"),
    }
    for name, pattern in patterns.items():
        if pattern.fullmatch(selected[name]) is None:
            raise UsageError(f"GCP {name} contains unsupported characters")
    return selected


def saved_persistence(saved: dict[str, Any], backend: str) -> Any:
    by_backend = saved.get("persistent_workspaces")
    if isinstance(by_backend, dict) and backend in by_backend:
        return by_backend[backend]
    # Single project-wide value from earlier releases and prototypes.
    return saved.get("persistent_workspace", saved.get("checkpoint"))


def remember_persistence(saved: dict[str, Any], backend: str, enabled: bool) -> None:
    by_backend = saved.get("persistent_workspaces")
    by_backend = dict(by_backend) if isinstance(by_backend, dict) else {}
    by_backend[backend] = enabled
    saved["persistent_workspaces"] = by_backend
    saved["persistent_workspace"] = enabled
    saved["checkpoint"] = enabled


def resolve_preferences(
    project: Path, options: dict[str, Any], config_home: Path, key: str
) -> tuple[str, str | None, bool, str | None, bool, str]:
    global_config = load_json(config_home / "config.json")
    shared_config = load_json(project / ".cloudmake.json")
    project_config = load_json(config_home / "projects" / f"{key}.json")

    backend_value = (
        options["backend"]
        or os.environ.get("CLOUDMAKE_BACKEND")
        or project_config.get("backend")
        or shared_config.get("backend")
        or global_config.get("backend")
        or "colab-notebook"
    )
    backend = canonical_backend(str(backend_value))
    ssh_host = (
        resolve_ssh_host(options, project_config, global_config)
        if backend == "host-ssh"
        else None
    )

    checkpoint: Any = options["checkpoint"]
    if checkpoint is None:
        checkpoint = saved_persistence(project_config, backend)
    if checkpoint is None:
        checkpoint = False
    if not isinstance(checkpoint, bool):
        raise UsageError("configured persistent-workspace selection must be true or false")

    workspace_id = configured_workspace_id(project_config, key, backend)

    if options["accelerator_set"]:
        return backend, options["accelerator"], True, ssh_host, checkpoint, workspace_id
    if "CLOUDMAKE_GPU" in os.environ:
        return backend, os.environ["CLOUDMAKE_GPU"], True, ssh_host, checkpoint, workspace_id
    for config in (project_config, shared_config, global_config):
        if "accelerator" in config:
            if backend not in GPU_BACKENDS:
                return backend, None, False, ssh_host, checkpoint, workspace_id
            value = config["accelerator"]
            if not isinstance(value, str):
                raise UsageError("configured accelerator must be a string")
            return backend, value, True, ssh_host, checkpoint, workspace_id
    return backend, None, False, ssh_host, checkpoint, workspace_id


def validate_runner_selection(
    image: Any, devices: Any
) -> tuple[str, str | None, list[str]]:
    if image is None:
        if devices:
            raise UsageError("CDI devices require an OCI image selection")
        return "native", None, []
    if not isinstance(image, str) or OCI_IMAGE.fullmatch(image) is None:
        raise UsageError(
            "--image requires an immutable OCI reference of the form "
            "REGISTRY/IMAGE@sha256:<64 lowercase hex digits>"
        )
    if not isinstance(devices, list) or not all(isinstance(item, str) for item in devices):
        raise UsageError("configured CDI devices must be a string list")
    for device in devices:
        if CDI_DEVICE.fullmatch(device) is None:
            raise UsageError(
                f"invalid CDI device {device!r}; expected vendor.example/class=device"
            )
    if len(set(devices)) != len(devices):
        raise UsageError("duplicate CDI device selections are not allowed")
    return "oci", image, devices


def validate_backend_oci_selection(
    *, backend: str, runner: str, devices: list[str], accelerator: Any
) -> list[str]:
    runtimes = backend_oci_runtimes(backend)
    if (
        backend == "colab-notebook"
        and isinstance(accelerator, str)
        and accelerator.startswith("tpu-")
        and runner != "native"
    ):
        raise UsageError("Colab TPU targets require the native runner")
    if runner in {"native", "devcontainer-native"}:
        return runtimes
    native = backend_oci_native(backend)
    if not runtimes and not native:
        raise UsageError(f"backend {backend!r} does not support the managed OCI runner")
    if native and devices:
        raise UsageError(
            f"backend {backend!r} does not expose CDI devices through its native OCI environment"
        )
    cdi_capable = {"podman", "docker", "nerdctl", "proot", "crun"}
    if devices and not cdi_capable.intersection(runtimes):
        raise UsageError(
            f"backend {backend!r} OCI runtime options cannot apply CDI devices"
        )
    if accelerator and not cdi_capable.intersection(runtimes):
        raise UsageError(
            f"backend {backend!r} OCI runtime options are CPU-only; "
            "select --cpu or --native"
        )
    return runtimes


def select_devcontainer_runner(backend: str, profile: dict[str, Any]) -> str:
    capabilities = set(backend_declaration(backend, "BACKEND_CAPABILITIES").split())
    if "devcontainer" not in capabilities:
        raise UsageError(
            f"backend {backend!r} does not declare Dev Container support"
        )
    required = set(profile.get("required_capabilities", []))
    adapter, native = validate_backend_devcontainer_contract(backend)
    realization_capabilities = {"adapter": adapter, "native": native}
    for realization in backend_devcontainer_realization_order(backend, adapter, native):
        if required <= realization_capabilities[realization]:
            profile["selected_engine"] = realization
            if realization == "adapter" or backend_oci_native(backend):
                return "oci"
            return "devcontainer-native"
    sources = profile.get("requirement_sources", {})

    def format_requirements(values: set[str] | list[str]) -> str:
        return ", ".join(
            f"{capability} ({', '.join(sources.get(capability, []))})"
            if sources.get(capability)
            else capability
            for capability in sorted(values)
        )

    missing = sorted(required - (adapter | native))
    if "privilege" in missing:
        raise UsageError(
            f"backend {backend!r} cannot honor privileged Dev Container semantics "
            f"required by {format_requirements({'privilege'})}; "
            "Cloudmake's least-privilege profile fails closed"
        )
    if not missing:
        raise UsageError(
            f"backend {backend!r} cannot honor the complete Dev Container requirement set "
            "with one declared realization; Cloudmake does not combine partial semantics; "
            f"adapter missing: {format_requirements(required - adapter)}; "
            f"native missing: {format_requirements(required - native)}"
        )
    raise UsageError(
        f"backend {backend!r} cannot honor Dev Container requirement(s): "
        + format_requirements(missing)
    )


def validate_devcontainer_backend(
    *, backend: str, profile: dict[str, Any] | None, accelerator: str | None
) -> None:
    if profile is None:
        return
    capabilities = set(backend_declaration(backend, "BACKEND_CAPABILITIES").split())
    ports = profile.get("forward_ports", [])
    transport = backend_declaration(backend, "BACKEND_TRANSPORT")
    if ports and "port-forward" not in capabilities:
        raise UsageError(
            f"backend {backend!r} cannot honor Dev Container forwardPorts; "
            "select an SSH or local backend"
        )
    gpu = profile.get("host_requirements", {}).get("gpu")
    managed_accelerator_backends = {
        "colab-notebook", "colab-ssh", "lightning-studio-ssh"
    }
    if (
        backend in managed_accelerator_backends
        and (gpu is True or profile.get("devices"))
        and not accelerator
    ):
        raise UsageError(
            f"backend {backend!r} requires --gpu (or a saved GPU selection) "
            "for this Dev Container profile"
        )
    if backend == "codespaces-ssh" and (gpu is True or isinstance(gpu, dict)):
        raise UsageError(
            "backend 'codespaces-ssh' declares a CPU-only workstation and cannot "
            "satisfy required Dev Container GPU host requirements"
        )


def validate_native_devcontainer_prerequisites(
    *, backend: str, runner: str, doctor: bool = False
) -> None:
    if runner != "devcontainer-native":
        return
    if backend != "local":
        raise UsageError(
            f"backend {backend!r} has no implemented native Dev Container engine"
        )
    devcontainer = shutil.which("devcontainer")
    docker = shutil.which("docker")
    missing = [name for name, path in (("devcontainer", devcontainer), ("docker", docker)) if path is None]
    if missing:
        raise UsageError(
            "native Dev Container execution requires: " + ", ".join(missing)
        )
    if doctor:
        assert devcontainer is not None and docker is not None
        probe = subprocess.run(
            [docker, "info"],
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            check=False,
        )
        if probe.returncode:
            detail = probe.stderr.strip().splitlines()[-1] if probe.stderr.strip() else "unavailable"
            raise UsageError(f"local Docker service is not ready: {detail}")
        version = subprocess.run(
            [devcontainer, "--version"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
        )
        if version.returncode:
            raise UsageError("reference Dev Container CLI failed its version probe")
        print(f"[doctor] Native Dev Container CLI: {version.stdout.strip()}")
        print("[doctor] Local Docker service: ready")


def resolve_runner_preferences(
    options: dict[str, Any], project: Path, config_home: Path, key: str, backend: str
) -> tuple[str, str | None, list[str], dict[str, Any] | None]:
    if options["native_runner"] and options["image"] is not None:
        raise UsageError("--native cannot be combined with --image")
    if options["native_runner"] and options["devcontainer"] is not None:
        raise UsageError("--native cannot be combined with --devcontainer")
    if options["image"] is not None and options["devcontainer"] is not None:
        raise UsageError("--image cannot be combined with --devcontainer")
    if options["native_runner"] and options["devices_set"]:
        raise UsageError("--native cannot be combined with --device or --no-devices")
    project_config = load_json(config_home / "projects" / f"{key}.json")
    shared_config = load_json(project / ".cloudmake.json")
    global_config = load_json(config_home / "config.json")
    if options["native_runner"]:
        return "native", None, [], None

    selected_devcontainer: Any = options["devcontainer"]
    if selected_devcontainer is None and options["image"] is None:
        # A repository merely containing a Dev Container description or shared
        # Cloudmake configuration must not silently change execution. Only an
        # explicit option persisted in this host's per-project state is reused.
        if "devcontainer" in project_config:
            selected_devcontainer = project_config["devcontainer"]
    if selected_devcontainer is not None:
        if options["devices_set"]:
            raise UsageError(
                "--device/--no-devices cannot be combined with a Dev Container; "
                "use customizations.cloudmake.devices"
            )
        if not isinstance(selected_devcontainer, str):
            raise UsageError("configured Dev Container path must be a string")
        try:
            profile = normalize_devcontainer(project, selected_devcontainer)
        except DevContainerError as error:
            raise UsageError(str(error)) from error
        return (
            select_devcontainer_runner(backend, profile),
            profile["image"],
            profile["devices"],
            profile,
        )

    configured_image: Any = None
    configured_devices: Any = []
    for config in (project_config, shared_config, global_config):
        if "image" in config:
            configured_image = config["image"]
            configured_devices = config.get("devices", [])
            break
    image = options["image"] if options["image"] is not None else configured_image
    if options["devices_set"]:
        devices = options["devices"]
    elif options["image"] is not None:
        # A new image selection must not silently inherit device requirements
        # from the previously selected image.
        devices = []
    else:
        devices = configured_devices
    runner, image, devices = validate_runner_selection(image, devices)
    return runner, image, devices, None


def persist_invocation_runner(
    *,
    project: Path,
    config_home: Path,
    key: str,
    runner: str,
    image: str | None,
    devices: list[str],
    devcontainer: dict[str, Any] | None,
) -> None:
    path = config_home / "projects" / f"{key}.json"
    saved = load_json(path)
    if runner == "native":
        saved.pop("image", None)
        saved.pop("devices", None)
        saved.pop("devcontainer", None)
    elif devcontainer is not None:
        saved["devcontainer"] = devcontainer["path"]
        saved.pop("image", None)
        saved.pop("devices", None)
    else:
        saved["image"] = image
        saved["devices"] = devices
        saved.pop("devcontainer", None)
    saved["project"] = os.fspath(project)
    atomic_json(path, saved)
    if runner == "native":
        detail = "runner=native"
    elif runner == "devcontainer-native":
        detail = "runner=devcontainer-native"
    else:
        detail = f"runner=oci image={image}"
    if devcontainer is not None:
        detail += f" devcontainer={devcontainer['path']}"
    if devices:
        detail += f" devices={','.join(devices)}"
    print(
        f"[cloudmake] selected {detail} for project={project.name}; "
        "subsequent targets reuse this selection.",
        flush=True,
    )


def validate_project(project: Path) -> Path:
    resolved = project.expanduser().resolve()
    if not resolved.is_dir():
        raise UsageError(f"project directory does not exist: {resolved}")
    return resolved


def validate_assignments(arguments: list[str]) -> None:
    for argument in arguments:
        if not ASSIGNMENT.match(argument):
            raise UsageError(
                f"unexpected argument {argument!r}; trailing arguments must be NAME=value"
            )
        name = argument.split("=", 1)[0]
        if name in RESERVED_ASSIGNMENTS:
            raise UsageError(f"{name} is managed by cloudmake and cannot be overridden here")


def encoded_arguments(arguments: list[str]) -> str:
    payload = json.dumps(arguments, ensure_ascii=False, separators=(",", ":")).encode()
    return base64.urlsafe_b64encode(payload).decode("ascii")


def encoded_object(value: dict[str, Any]) -> str:
    payload = json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode()
    return base64.urlsafe_b64encode(payload).decode("ascii")


def encoded_value(value: str) -> str:
    return base64.urlsafe_b64encode(value.encode("utf-8")).decode("ascii")


def retry_duration(value: str | None) -> int | None:
    if value is None:
        return None
    match = DURATION.fullmatch(value)
    if match is None:
        raise UsageError("--retry-for requires a positive duration such as 30s, 15m, or 2h")
    amount = int(match.group(1))
    multiplier = {"s": 1, "m": 60, "h": 3600}[match.group(2)]
    seconds = amount * multiplier
    if seconds > 24 * 3600:
        raise UsageError("--retry-for must not exceed 24h")
    return seconds


def replay_duration(value: str | None) -> int | None:
    if value is None:
        return None
    match = DURATION.fullmatch(value)
    if match is None:
        raise UsageError(
            "--replay-for requires a positive duration such as 30s, 15m, or 2h"
        )
    amount = int(match.group(1))
    multiplier = {"s": 1, "m": 60, "h": 3600}[match.group(2)]
    seconds = amount * multiplier
    if seconds > 24 * 3600:
        raise UsageError("--replay-for must not exceed 24h")
    return seconds


def collect_directory(value: str) -> str:
    path = PurePosixPath(value)
    if (
        not value
        or "\n" in value
        or path.is_absolute()
        or ".." in path.parts
        or (not path.parts and value != ".")
        or (path.parts and path.parts[0] == ".cloudmake")
    ):
        raise UsageError("collection directory must be a safe project-relative path")
    return path.as_posix()


def collection_destination(project: Path) -> Path:
    namespace = project / ".cloudmake"
    destination = namespace / "artifacts"
    if namespace.is_symlink():
        raise UsageError(f"reserved Cloudmake namespace must not be a symlink: {namespace}")
    if namespace.exists() and not namespace.is_dir():
        raise UsageError(f"reserved Cloudmake namespace is not a directory: {namespace}")
    if destination.is_symlink():
        raise UsageError(f"artifact destination must not be a symlink: {destination}")
    if destination.exists() and not destination.is_dir():
        raise UsageError(f"artifact destination is not a directory: {destination}")
    return destination


def run_foreground_command(command: list[str], *, cwd: Path) -> int:
    """Run one foreground command and propagate cancellation to its process tree."""
    process = subprocess.Popen(
        command,
        cwd=cwd,
        start_new_session=os.name == "posix",
    )
    terminated = False

    def forward(signum: int, _frame: Any) -> None:
        nonlocal terminated
        terminated = True
        try:
            if os.name == "posix":
                os.killpg(process.pid, signum)
            else:
                process.send_signal(signum)
        except ProcessLookupError:
            pass

    previous_sigterm: Any = None
    handler_installed = False
    try:
        previous_sigterm = signal.signal(signal.SIGTERM, forward)
        handler_installed = True
    except ValueError:
        # signal handlers can be installed only by Python's main thread.
        pass
    try:
        try:
            return_code = process.wait()
        except KeyboardInterrupt:
            forward(signal.SIGINT, None)
            process.wait()
            raise
    finally:
        if handler_installed:
            signal.signal(signal.SIGTERM, previous_sigterm)
    return 128 + signal.SIGTERM if terminated else return_code


def engine_command(
    *,
    project: Path,
    backend: str,
    accelerator: str | None,
    accelerator_set: bool,
    ssh_host: str | None,
    jobs: str | None,
    verbose: bool,
    state_home: Path,
    cache_home: Path,
    key: str,
    workspace_id: str,
    target: str,
    assignments: list[str],
    retry_seconds: int | None,
    adopt_from: str | None = None,
    codespace: str | None = None,
    gcp_resource: dict[str, str] | None = None,
    allocation_result: Path | None = None,
    remote_target: str | None = None,
    remote_collect_dir: str | None = None,
    run_id: str | None = None,
    checkpoint: bool = False,
    native_persist: bool = False,
    colab_session: str | None = None,
    operation_state: Path | None = None,
    runner: str = "native",
    image: str | None = None,
    devices: list[str] | None = None,
    oci_runtimes: list[str] | None = None,
    devcontainer: dict[str, Any] | None = None,
) -> int:
    make = shutil.which("make")
    if make is None:
        raise UsageError("make was not found on PATH")
    variables = [
        f"CLOUDMAKE_TOOL_ROOT={TOOL_ROOT}",
        f"PROJECT_DIR={project}",
        f"CLOUDMAKE_PROJECT_ROOT={project}",
        f"PROJECT={project.name}",
        f"PROJECT_SLUG={project_slug(project, key)}",
        f"CLOUDMAKE_PROJECT_KEY={key}",
        f"CLOUDMAKE_WORKSPACE_ID={workspace_id}",
        f"CLOUDMAKE_CHECKPOINT={1 if checkpoint else 0}",
        f"CLOUDMAKE_NATIVE_PERSIST={1 if native_persist else 0}",
        "PROJECT_MAKEFILE=Makefile",
        f"ARTIFACT_DIR={project / COLLECTION_RELATIVE}",
        f"CLOUDMAKE_STATE_ROOT={state_home / 'projects' / key}",
        f"CLOUDMAKE_CACHE_ROOT={cache_home / 'projects' / key}",
        f"CLOUDMAKE_PROJECT_ARGS_B64={encoded_arguments(assignments)}",
        f"CLOUDMAKE_RETRY_FOR_SECONDS={retry_seconds or 0}",
        f"BACKEND={backend}",
        f"PYTHON_BIN={sys.executable}",
        f"CLOUDMAKE_RUNNER={runner}",
    ]
    if runner == "oci":
        if image is None:
            raise UsageError("internal OCI runner selection has no image")
        variables.extend(
            [
                f"CLOUDMAKE_OCI_IMAGE_B64={encoded_value(image)}",
                f"CLOUDMAKE_OCI_DEVICES_B64={encoded_arguments(devices or [])}",
                f"CLOUDMAKE_OCI_RUNTIMES_B64={encoded_arguments(oci_runtimes or [])}",
                f"CLOUDMAKE_OCI_ENVIRONMENT_B64={encoded_arguments((devcontainer or {}).get('environment', []))}",
                f"CLOUDMAKE_HOST_REQUIREMENTS_B64={encoded_object((devcontainer or {}).get('host_requirements', {}))}",
                f"CLOUDMAKE_FORWARD_PORTS_B64={encoded_arguments((devcontainer or {}).get('forward_ports', []))}",
                f"CLOUDMAKE_DEVCONTAINER_ACTIVE={'1' if devcontainer is not None else ''}",
                "CLOUDMAKE_OCI_RUNTIME=auto",
            ]
        )
        ports = (devcontainer or {}).get("forward_ports", [])
        if ports:
            variables.append(
                "CLOUDMAKE_SSH_FORWARD_OPTIONS="
                + "-o ExitOnForwardFailure=yes "
                + " ".join(
                    f"-L {item['port']}:{item['host']}:{item['port']}" for item in ports
                )
            )
    if run_id is not None:
        variables.append(f"CLOUDMAKE_RUN_ID={run_id}")
    if allocation_result is not None:
        variables.append(f"CLOUDMAKE_ALLOCATION_RESULT={allocation_result}")
    if colab_session is not None:
        variables.append(f"COLAB_SESSION={colab_session}")
    if operation_state is not None:
        variables.append(f"CLOUDMAKE_OPERATION_STATE={operation_state}")
    if jobs is not None:
        if not jobs.isdigit() or int(jobs) < 1:
            raise UsageError("-j requires a positive integer")
        variables.append(f"JOBS={jobs}")
    if verbose:
        variables.append("CLOUDMAKE_VERBOSE=1")
    if backend == "host-ssh" and ssh_host is not None:
        variables.append(f"SSH_HOST={ssh_host}")
    if backend == "codespaces-ssh" and codespace is not None:
        variables.extend(
            [
                f"CODESPACE={codespace}",
                # A Codespace has one active provider-native OCI environment.
                # Serialize the complete operation across local projects that
                # share that resource, including reconciliation and dispatch.
                f"CLOUDMAKE_LOCK_FILE_OVERRIDE={state_home / 'resource-locks' / 'codespaces-ssh' / (codespace + '.lock')}",
            ]
        )
    if backend == "gcp-compute-ssh" and gcp_resource is not None:
        resource_id = "--".join(
            (gcp_resource["project"], gcp_resource["zone"], gcp_resource["instance"])
        )
        variables.extend(
            [
                f"GCP_PROJECT={gcp_resource['project']}",
                f"GCP_ZONE={gcp_resource['zone']}",
                f"GCP_INSTANCE={gcp_resource['instance']}",
                f"GCP_TUNNEL_THROUGH_IAP={gcp_resource['tunnel_through_iap']}",
                f"CLOUDMAKE_LOCK_FILE_OVERRIDE={state_home / 'resource-locks' / 'gcp-compute-ssh' / (resource_id + '.lock')}",
            ]
        )
    if adopt_from is not None:
        variables.append("CLOUDMAKE_ADOPT=1")
        variables.append(f"CLOUDMAKE_ADOPT_FROM={adopt_from}")
    if accelerator_set:
        variables.append(
            f"CLOUDMAKE_CONTEXT_ACCELERATOR={accelerator or 'cpu'}"
        )
        variable = {
            "colab-notebook": "COLAB_GPU",
            "colab-ssh": "COLAB_GPU",
            "kaggle-notebook": "KAGGLE_ACCELERATOR",
            "lightning-studio-ssh": "LIGHTNING_MACHINE",
            "modal-sandbox": "MODAL_GPU",
        }.get(backend, "CLOUDMAKE_GPU")
        if backend == "colab-notebook" and (accelerator or "").startswith("tpu-"):
            variables.append(f"COLAB_TPU={accelerator[4:]}")
            variables.append("COLAB_GPU=")
        else:
            variables.append(f"{variable}={accelerator or ''}")
    if remote_target is not None:
        variables.append(f"REMOTE_TARGET_B64={encoded_value(remote_target)}")
    if remote_collect_dir is not None:
        variables.append(
            f"REMOTE_COLLECT_DIR_B64={encoded_value(remote_collect_dir)}"
        )
    command = [make, "--no-print-directory", "-f", os.fspath(ENGINE), *variables]
    command.append(target)
    if verbose:
        print("+", " ".join(command), file=sys.stderr)
    return run_foreground_command(command, cwd=TOOL_ROOT)


def print_local_execution_context(accelerator: str | None, accelerator_set: bool) -> None:
    fields = ["backend=local"]
    if accelerator_set:
        fields.append(f"accelerator={accelerator or 'cpu'}")
    fields.append("resource=local")
    print("[cloudmake] " + " ".join(fields), flush=True)


def persist_invocation_accelerator(
    *,
    project: Path,
    config_home: Path,
    key: str,
    accelerator: str | None,
) -> None:
    path = config_home / "projects" / f"{key}.json"
    saved = load_json(path)
    saved["accelerator"] = accelerator or ""
    saved["project"] = os.fspath(project)
    atomic_json(path, saved)
    print(
        f"[cloudmake] selected accelerator={accelerator or 'cpu'} for "
        f"project={project.name}; subsequent targets reuse this selection.",
        flush=True,
    )


def persist_invocation_checkpoint(
    *, project: Path, config_home: Path, key: str, backend: str,
    workspace_id: str, enabled: bool, mode: str
) -> None:
    path = config_home / "projects" / f"{key}.json"
    saved = load_json(path)
    remember_persistence(saved, backend, enabled)
    if enabled and mode == "checkpoint":
        configured = saved.get("workspace_ids", {})
        if not isinstance(configured, dict):
            configured = {}
        configured = dict(configured)
        saved_backend = saved.get("backend")
        legacy = saved.get("workspace_id")
        if (
            isinstance(saved_backend, str)
            and saved_backend in {"colab-notebook", "kaggle-notebook"}
            and isinstance(legacy, str)
            and WORKSPACE_ID.fullmatch(legacy)
        ):
            configured.setdefault(saved_backend, legacy)
        configured[backend] = workspace_id
        saved["workspace_ids"] = configured
        if saved_backend in {None, backend}:
            saved["workspace_id"] = workspace_id
    saved["project"] = os.fspath(project)
    atomic_json(path, saved)
    print(
        f"[cloudmake] {persistence_selection_note(enabled, mode)} for "
        f"project={project.name}; subsequent targets reuse this selection.",
        flush=True,
    )


def local_make_command(
    *,
    project: Path,
    target: str,
    assignments: list[str],
    jobs: str | None,
    verbose: bool,
) -> int:
    """Invoke the project Makefile directly, without the backend engine."""
    make = shutil.which("make")
    if make is None:
        raise UsageError("make was not found on PATH")
    command = [make, "-f", "Makefile"]
    if jobs is not None:
        if not jobs.isdigit() or int(jobs) < 1:
            raise UsageError("-j requires a positive integer")
        command.extend(["-j", jobs])
    command.extend([target, *assignments])
    if verbose:
        print("+", " ".join(command), file=sys.stderr)
    return run_foreground_command(command, cwd=project)


def local_oci_command(
    *,
    project: Path,
    image: str,
    devices: list[str],
    oci_runtimes: list[str],
    target: str,
    assignments: list[str],
    jobs: str | None,
    state_root: Path,
    cache_home: Path,
    run_id: str,
    verbose: bool,
    devcontainer: dict[str, Any] | None,
) -> tuple[int, dict[str, Any]]:
    parallel = jobs or "4"
    if not parallel.isdigit() or int(parallel) < 1:
        raise UsageError("-j requires a positive integer")
    result = state_root / "oci" / run_id / "result.json"
    common = [
        sys.executable,
        os.fspath(TOOL_ROOT / "core" / "oci_runner.py"),
        "--image",
        image,
        "--runtime",
        "auto",
        "--source",
        os.fspath(project),
        "--cache",
        os.fspath(cache_home / "oci"),
        "--makefile",
        "Makefile",
    ]
    for runtime in oci_runtimes:
        common.extend(["--runtime-candidate", runtime])
    for device in devices:
        common.extend(["--device", device])
    for value in (devcontainer or {}).get("environment", []):
        common.extend(["--env", value])
    for item in (devcontainer or {}).get("forward_ports", []):
        common.extend(["--forward-port", str(item["port"])])
    requirements = (devcontainer or {}).get("host_requirements", {})
    if requirements:
        common.extend(["--host-requirements-b64", encoded_object(requirements)])
    workstation = " workstation=devcontainer" if devcontainer is not None else ""
    print(
        f"[cloudmake] backend=local runner=oci{workstation} "
        f"image={image} resource=local",
        flush=True,
    )
    command = [
        *common,
        "--mode",
        "run",
        "--target-b64",
        encoded_value(target),
        "--arguments-b64",
        encoded_arguments(assignments),
        "--jobs",
        parallel,
        "--result",
        os.fspath(result),
    ]
    if verbose:
        print("+", " ".join(command), file=sys.stderr)
    exit_code = run_foreground_command(command, cwd=project)
    return exit_code, load_json(result)


def local_native_devcontainer_command(
    *, project: Path, profile: dict[str, Any], target: str,
    assignments: list[str], jobs: str | None, state_root: Path,
    run_id: str, verbose: bool,
) -> tuple[int, dict[str, Any]]:
    parallel = jobs or "4"
    if not parallel.isdigit() or int(parallel) < 1:
        raise UsageError("-j requires a positive integer")
    try:
        check_devcontainer_host(profile.get("host_requirements", {}), project)
    except DevContainerError as error:
        raise UsageError(str(error)) from error
    result = state_root / "devcontainer" / run_id / "result.json"
    state = state_root / "devcontainer" / "workstation.json"
    command = [
        sys.executable, os.fspath(TOOL_ROOT / "core" / "devcontainer_native.py"),
        "--project", os.fspath(project), "--config", profile["path"],
        "--project-key", project_key(project),
        "--fingerprint", profile["fingerprint"], "--target", target,
        "--jobs", parallel, "--state", os.fspath(state),
        "--result", os.fspath(result),
    ]
    if profile.get("image"):
        command.extend(["--source-image", profile["image"]])
    for assignment in assignments:
        command.extend(["--assignment", assignment])
    print(
        "[cloudmake] backend=local runner=devcontainer-native "
        "workstation=devcontainer resource=local",
        flush=True,
    )
    if verbose:
        print("+", " ".join(command), file=sys.stderr)
    exit_code = run_foreground_command(command, cwd=project)
    return exit_code, load_json(result)


def collect_local_artifacts(
    *,
    project: Path,
    directory: str,
    state_root: Path,
    run_id: str,
    verbose: bool,
) -> int:
    """Materialize a local project directory through the normal safe extractor."""
    source = project / directory
    if source.is_symlink() or not source.is_dir():
        print(
            f"cloudmake: collection directory was not produced as a directory: {source}",
            file=sys.stderr,
        )
        return 2

    archive_directory = state_root / "local" / "collections"
    archive_directory.mkdir(parents=True, exist_ok=True)
    archive = archive_directory / f"{run_id}.tar.gz"
    temporary = archive_directory / f".{run_id}.tar.gz.tmp"
    try:
        with tarfile.open(temporary, "w:gz", dereference=False) as bundle:
            bundle.add(source, arcname=".")
        os.replace(temporary, archive)
    finally:
        temporary.unlink(missing_ok=True)

    command = [
        sys.executable,
        os.fspath(TOOL_ROOT / "core" / "safe_extract.py"),
        "--archive",
        os.fspath(archive),
        "--destination",
        os.fspath(collection_destination(project)),
    ]
    limits = {
        "ARTIFACT_MAX_FILES": "--max-files",
        "ARTIFACT_MAX_MB": "--max-total-mb",
        "ARTIFACT_MAX_FILE_MB": "--max-file-mb",
        "ARTIFACT_MAX_ARCHIVE_MB": "--max-archive-mb",
        "ARTIFACT_MAX_RATIO": "--max-ratio",
    }
    for variable, option in limits.items():
        if variable in os.environ:
            command.extend([option, os.environ[variable]])
    if verbose:
        print("+", " ".join(command), file=sys.stderr)
    return run_foreground_command(command, cwd=project)


def run(arguments: list[str]) -> int:
    options, positional = parse_invocation(arguments)
    retry_seconds = retry_duration(options["retry_for"])
    replay_seconds = replay_duration(options["replay_for"])
    project = validate_project(options["project"])
    config_home, state_home, cache_home = homes()
    key = project_key(project)
    action = options["action"]

    target_invocation = (action is None and bool(positional)) or action == "collect"
    source_sync_invocation = (action is None and bool(positional)) or action in {
        "collect",
        "sync",
    }
    if replay_seconds is not None and not options["idempotent"]:
        raise UsageError("--replay-for requires --idempotent")
    if (options["idempotent"] or replay_seconds is not None) and not target_invocation:
        raise UsageError("--idempotent and --replay-for are valid only for a project target")
    if options["accept_legacy_artifacts"] and not source_sync_invocation:
        raise UsageError(
            "--accept-legacy-artifacts-as-source is valid only for remote source "
            "synchronization"
        )

    if options["force"] and action != "workspace":
        raise UsageError("--force is valid only with --workspace purge")

    if retry_seconds is not None and action not in {None, "collect", "start"}:
        raise UsageError("--retry-for is valid only with --start, a project target, or --collect")

    if action == "version":
        if positional:
            raise UsageError("--version does not accept arguments")
        print(f"cloudmake {VERSION}")
        return 0
    if action == "backends":
        if positional:
            raise UsageError("--backends does not accept arguments")
        show_backends()
        return 0
    if action == "history":
        if positional:
            raise UsageError("--history does not accept arguments")
        show_history(state_home, key)
        return 0
    if action == "workspaces":
        if positional:
            raise UsageError("--workspaces does not accept arguments")
        show_workspaces(state_home)
        return 0
    if action == "workspace":
        return manage_workspace(
            project=project,
            project_id=key,
            config_home=config_home,
            state_home=state_home,
            cache_home=cache_home,
            options=options,
            positional=positional,
        )
    if action == "host-templates":
        if positional:
            raise UsageError("--host-templates does not accept arguments")
        show_host_templates()
        return 0
    if action == "host-template":
        if positional:
            raise UsageError("--host-template accepts its name as an option value only")
        show_host_template(options["host_template"])
        return 0
    if action == "use":
        if positional:
            raise UsageError("--use accepts its backend as an option value only")
        if options["backend"] is not None:
            raise UsageError("-b/--backend cannot be combined with --use")
        if options["global"] and options["checkpoint"] is not None:
            raise UsageError(
                "persistent workspaces must be enabled or disabled per project, "
                "not with --global"
            )
        if options["global"] and (
            options["image"] is not None
            or options["devcontainer"] is not None
            or options["native_runner"]
            or options["devices_set"]
        ):
            raise UsageError("workstation runner selection is per project, not global")
        backend = options["use_backend"]
        warn_backend_status(backend)
        if options["global"] and backend == "gcp-compute-ssh":
            raise UsageError("the GCP VM selection is per project, not global")
        accelerator_set = options["accelerator_set"]
        accelerator = options["accelerator"]
        if accelerator_set and not ACCELERATOR.fullmatch(accelerator or ""):
            raise UsageError("invalid accelerator name")
        if accelerator and backend not in GPU_BACKENDS:
            raise UsageError(f"backend {backend!r} does not support accelerator requests")
        if accelerator and accelerator.startswith("tpu-") and backend != "colab-notebook":
            raise UsageError("--tpu is supported only by the Colab notebook backend")
        if options["host"] is not None and backend != "host-ssh":
            raise UsageError("--host is valid only with the ssh backend")
        path = (
            config_home / "config.json"
            if options["global"]
            else config_home / "projects" / f"{key}.json"
        )
        saved = load_json(path)
        global_config = load_json(config_home / "config.json")
        project_config = saved if not options["global"] else {}
        configured_persistence: Any = saved_persistence(saved, backend)
        if configured_persistence is None:
            configured_persistence = False
        if not isinstance(configured_persistence, bool):
            raise UsageError(
                "configured persistent-workspace selection must be true or false"
            )
        selected_persistence = (
            options["checkpoint"]
            if options["checkpoint"] is not None
            else configured_persistence
        )
        persistence_mode = validate_persistence(backend, selected_persistence)
        previous_backend = saved.get("backend")
        legacy_workspace_id = saved.get("workspace_id")
        if (
            isinstance(previous_backend, str)
            and previous_backend in {"colab-notebook", "kaggle-notebook"}
            and isinstance(legacy_workspace_id, str)
            and WORKSPACE_ID.fullmatch(legacy_workspace_id)
        ):
            workspace_ids = saved.get("workspace_ids", {})
            if isinstance(workspace_ids, dict):
                workspace_ids = dict(workspace_ids)
                workspace_ids.setdefault(previous_backend, legacy_workspace_id)
                saved["workspace_ids"] = workspace_ids
        selected_workspace_id = configured_workspace_id(saved, key, backend)
        ssh_host = (
            resolve_ssh_host(options, project_config, global_config)
            if backend == "host-ssh"
            else None
        )
        if backend == "host-ssh" and ssh_host is None:
            raise UsageError("the ssh backend requires --host HOST")
        selected_colab_session = None
        if backend == "colab-notebook" and "COLAB_SESSION" in os.environ:
            selected_colab_session = os.environ["COLAB_SESSION"]
            if not COLAB_SESSION_NAME.fullmatch(selected_colab_session):
                raise UsageError(
                    "Colab session names must contain only letters, numbers, dot, "
                    "dash, and underscore"
                )
            if options["global"]:
                raise UsageError(
                    "COLAB_SESSION can be persisted only with per-project --use"
                )
        saved["backend"] = backend
        if accelerator_set:
            saved["accelerator"] = accelerator or ""
        if backend == "host-ssh":
            saved["host"] = ssh_host
        selected_gcp = None
        if backend == "gcp-compute-ssh":
            selected_gcp = resolve_gcp_resource(config_home, key)
            if selected_gcp is None:
                raise UsageError(
                    "the GCP backend requires GCP_PROJECT, GCP_ZONE, and GCP_INSTANCE"
                )
            saved["gcp"] = selected_gcp
        selected_codespace = None
        if backend == "codespaces-ssh" and not options["global"]:
            selected_codespace = os.environ.get("CODESPACE")
            if selected_codespace is not None:
                if COLAB_SESSION_NAME.fullmatch(selected_codespace) is None:
                    raise UsageError(
                        "Codespace names may contain only letters, numbers, dot, "
                        "dash, and underscore"
                    )
                saved["codespace"] = selected_codespace
        if selected_colab_session is not None:
            saved["colab_session"] = selected_colab_session
        if options["checkpoint"] is not None:
            remember_persistence(saved, backend, options["checkpoint"])
        if (
            selected_persistence
            and persistence_mode == "checkpoint"
            and not options["global"]
        ):
            remember_workspace_id(saved, backend, selected_workspace_id)
        elif previous_backend != backend:
            saved.pop("workspace_id", None)
        runner, image, devices, devcontainer = resolve_runner_preferences(
            options, project, config_home, key, backend
        )
        effective_accelerator = (
            accelerator
            if accelerator_set
            else saved.get("accelerator", global_config.get("accelerator", ""))
        )
        validate_backend_oci_selection(
            backend=backend,
            runner=runner,
            devices=devices,
            accelerator=effective_accelerator,
        )
        validate_devcontainer_backend(
            backend=backend,
            profile=devcontainer,
            accelerator=effective_accelerator,
        )
        if runner == "native":
            saved.pop("image", None)
            saved.pop("devices", None)
            saved.pop("devcontainer", None)
        elif devcontainer is not None:
            saved["devcontainer"] = devcontainer["path"]
            saved.pop("image", None)
            saved.pop("devices", None)
        else:
            saved["image"] = image
            saved["devices"] = devices
            saved.pop("devcontainer", None)
        if not options["global"]:
            saved["project"] = os.fspath(project)
        atomic_json(path, saved)
        scope = "global" if options["global"] else project.name
        accelerator_note = (
            f", accelerator={accelerator or 'cpu'}" if accelerator_set else ""
        )
        host_note = f", host={ssh_host}" if backend == "host-ssh" else ""
        session_note = (
            f", session={selected_colab_session}"
            if selected_colab_session is not None
            else ""
        )
        codespace_note = (
            f", codespace={selected_codespace}"
            if selected_codespace is not None
            else ""
        )
        gcp_note = (
            f", project={selected_gcp['project']}, zone={selected_gcp['zone']}, "
            f"instance={selected_gcp['instance']}"
            if selected_gcp is not None
            else ""
        )
        checkpoint_note = (
            f", {persistence_selection_note(selected_persistence, persistence_mode)}"
            if options["checkpoint"] is not None or selected_persistence
            else ""
        )
        if runner == "native":
            runner_note = ", runner=native"
        elif runner == "devcontainer-native":
            runner_note = ", runner=devcontainer-native"
        else:
            runner_note = f", runner=oci, image={image}"
        if devcontainer is not None:
            runner_note += f", devcontainer={devcontainer['path']}"
        device_note = f", devices={','.join(devices)}" if devices else ""
        print(
            f"Saved {scope} backend={backend}{host_note}{accelerator_note}"
            f"{session_note}{codespace_note}{gcp_note}{checkpoint_note}{runner_note}{device_note}; "
            "subsequent targets reuse this selection."
        )
        if (
            selected_persistence
            and persistence_mode == "checkpoint"
            and not options["global"]
        ):
            record_accelerator = saved.get(
                "accelerator", global_config.get("accelerator", "")
            )
            state_root = state_home / "projects" / key
            update_workspace_record(
                state_home=state_home,
                workspace_id=selected_workspace_id,
                project=project,
                backend=backend,
                accelerator=(
                    str(record_accelerator) if isinstance(record_accelerator, str) else None
                ),
                session=colab_session_name(project, key, state_root, config_home),
            )
        return 0
    if options["global"]:
        raise UsageError("--global is valid only with --use")

    (
        backend,
        accelerator,
        accelerator_set,
        ssh_host,
        checkpoint,
        workspace_id,
    ) = resolve_preferences(project, options, config_home, key)
    pending_adoption = attached_adoption(config_home, key, backend, workspace_id)
    adopt_from = (
        pending_adoption if os.environ.get("CLOUDMAKE_ADOPT") != "1" else None
    )
    replay_capability = backend_target_replay(backend)
    workstation_option = (
        options["image"] is not None
        or options["devcontainer"] is not None
        or options["native_runner"]
        or options["devices_set"]
    )
    workstation_actions = {None, "collect", "start", "doctor"}
    if workstation_option and action not in {None, "collect", "start"}:
        raise UsageError(
            "workstation runner selection is valid only with --use, --start, a project target, "
            "or --collect"
        )
    if action in workstation_actions:
        runner, image, devices, devcontainer = resolve_runner_preferences(
            options, project, config_home, key, backend
        )
    else:
        # Resource inspection, shutdown, source transfer, and artifact retrieval
        # must remain available even if a saved workstation profile becomes
        # invalid or unsupported after an upgrade. They do not prepare or run it.
        runner, image, devices, devcontainer = "native", None, [], None
    codespace = resolve_codespace(config_home, key) if backend == "codespaces-ssh" else None
    gcp_resource = (
        resolve_gcp_resource(config_home, key)
        if backend == "gcp-compute-ssh"
        else None
    )
    if options["host"] is not None and backend != "host-ssh":
        raise UsageError("--host is valid only with the ssh backend")
    if accelerator_set and not ACCELERATOR.fullmatch(accelerator or ""):
        raise UsageError(
            "accelerator names may contain only letters, numbers, dot, dash, and underscore"
        )
    if accelerator and backend not in GPU_BACKENDS:
        raise UsageError(f"backend {backend!r} does not support accelerator requests")
    if accelerator and accelerator.startswith("tpu-") and backend != "colab-notebook":
        raise UsageError("--tpu is supported only by the Colab notebook backend")
    persistence_mode = validate_persistence(backend, checkpoint)
    oci_runtimes = validate_backend_oci_selection(
        backend=backend, runner=runner, devices=devices, accelerator=accelerator
    )
    validate_devcontainer_backend(
        backend=backend, profile=devcontainer, accelerator=accelerator
    )
    managed_checkpoint = checkpoint and persistence_mode == "checkpoint"
    native_persist = checkpoint and persistence_mode == "native"
    if action == "environment" and backend not in {
        "local", "colab-notebook", "gcp-compute-ssh"
    }:
        raise UsageError(
            f"backend {backend!r} does not yet provide an execution-environment profile"
        )
    if options["checkpoint"] is not None and action not in {None, "collect", "start"}:
        raise UsageError(
            "--persist/--no-persist is valid only with --use, --start, "
            "a project target, or --collect"
        )
    if retry_seconds is not None and backend not in CAPACITY_RETRY_BACKENDS:
        raise UsageError(
            f"backend {backend!r} does not classify retryable allocation capacity"
        )
    if replay_seconds is not None:
        if replay_capability == "fenced":
            raise UsageError(
                f"backend {backend!r} declares fenced target replay, but this "
                "release has no bounded replay dispatcher"
            )
        raise UsageError(
            f"backend {backend!r} declares target_replay=none and cannot prove "
            "fenced, non-overlapping target attempts; "
            "bounded replay is unsupported"
        )
    if retry_seconds is not None and action is None and not positional:
        raise UsageError("--retry-for requires --start, a project target, or --collect")
    if action == "help" or (action is None and not positional):
        if positional:
            raise UsageError("--help does not accept arguments")
        print(help_text(project, backend, ssh_host), end="")
        return 0
    if backend == "host-ssh" and ssh_host is None:
        raise UsageError("the ssh backend requires --host HOST")
    if backend == "gcp-compute-ssh" and gcp_resource is None:
        raise UsageError(
            "the GCP backend requires GCP_PROJECT, GCP_ZONE, and GCP_INSTANCE; "
            "set them once and run: cloudmake --use gcp"
        )
    warn_backend_status(backend)

    if action is None:
        remote_target, assignments = positional[0], positional[1:]
        remote_collect_dir = None
        engine_target = "dispatch"
    elif action == "collect":
        if len(positional) < 2:
            raise UsageError("--collect requires a directory and project target")
        remote_collect_dir = collect_directory(positional[0])
        remote_target, assignments = positional[1], positional[2:]
        engine_target = "collect"
    else:
        if positional:
            raise UsageError(f"--{action} does not accept positional arguments")
        remote_target = None
        remote_collect_dir = None
        assignments = []
        engine_target = action

    validate_assignments(assignments)
    if remote_target is not None and (not remote_target or "\n" in remote_target):
        raise UsageError("project targets must be non-empty and contain no newline")
    if engine_target in {"dispatch", "collect"}:
        if not (project / "Makefile").is_file():
            raise UsageError(f"project Makefile was not found: {project / 'Makefile'}")
    if engine_target in {"collect", "fetch"}:
        collection_destination(project)
    if engine_target in {"dispatch", "collect", "doctor"}:
        validate_native_devcontainer_prerequisites(
            backend=backend,
            runner=runner,
            doctor=engine_target == "doctor",
        )

    if (
        options["accelerator_set"]
        and options["backend"] is None
        and engine_target in {"dispatch", "collect", "start", "environment"}
    ):
        persist_invocation_accelerator(
            project=project,
            config_home=config_home,
            key=key,
            accelerator=accelerator,
        )
    if (
        options["checkpoint"] is not None
        and engine_target in {"dispatch", "collect", "start"}
    ):
        persist_invocation_checkpoint(
            project=project,
            config_home=config_home,
            key=key,
            backend=backend,
            workspace_id=workspace_id,
            enabled=checkpoint,
            mode=persistence_mode,
        )
    if (
        (
            options["image"] is not None
            or options["devcontainer"] is not None
            or options["native_runner"]
            or options["devices_set"]
        )
        and options["backend"] is None
        and engine_target in {"dispatch", "collect", "start"}
    ):
        persist_invocation_runner(
            project=project,
            config_home=config_home,
            key=key,
            runner=runner,
            image=image,
            devices=devices,
            devcontainer=devcontainer,
        )
    state_root = state_home / "projects" / key
    if backend != "local" and engine_target in {"dispatch", "collect", "sync"}:
        preflight_legacy_artifacts(
            project=project,
            state_root=state_root,
            accept_as_source=options["accept_legacy_artifacts"],
        )
    elif options["accept_legacy_artifacts"]:
        raise UsageError(
            "--accept-legacy-artifacts-as-source is valid only for remote source "
            "synchronization"
        )
    colab_session = (
        colab_session_name(project, key, state_root, config_home)
        if backend == "colab-notebook"
        else None
    )
    if checkpoint and engine_target in {"dispatch", "collect", "start"}:
        if persistence_mode == "native":
            print(
                f"[cloudmake] persistence=native backend={backend} "
                "checkpoint-transfer=no",
                flush=True,
            )
        else:
            print(
                f"[cloudmake] persistence=checkpoint backend={backend} "
                f"workspace={workspace_id}",
                flush=True,
            )
    if managed_checkpoint:
        update_workspace_record(
            state_home=state_home,
            workspace_id=workspace_id,
            project=project,
            backend=backend,
            accelerator=accelerator,
            session=colab_session,
        )
    if engine_target not in {"dispatch", "collect"}:
        operation_allocation_path = (
            state_root / "operations" / f".{uuid.uuid4().hex}.allocation.json"
            if backend == "colab-notebook"
            else None
        )
        operation_state = (
            state_root / "operations" / f"{engine_target}.json"
            if backend == "colab-notebook"
            else None
        )
        if operation_state is not None:
            operation_state.unlink(missing_ok=True)
        exit_code = engine_command(
            project=project,
            backend=backend,
            accelerator=accelerator,
            accelerator_set=accelerator_set,
            ssh_host=ssh_host,
            jobs=options["jobs"],
            verbose=options["verbose"],
            state_home=state_home,
            cache_home=cache_home,
            key=key,
            workspace_id=workspace_id,
            adopt_from=adopt_from,
            target=engine_target,
            assignments=assignments,
            retry_seconds=retry_seconds,
            codespace=codespace,
            gcp_resource=gcp_resource,
            allocation_result=operation_allocation_path,
            remote_target=remote_target,
            remote_collect_dir=remote_collect_dir,
            checkpoint=managed_checkpoint,
            native_persist=native_persist,
            colab_session=colab_session,
            operation_state=operation_state,
            runner=runner,
            image=image,
            devices=devices,
            oci_runtimes=oci_runtimes,
            devcontainer=devcontainer,
        )
        if operation_allocation_path is not None:
            receipt = allocation_receipt(operation_allocation_path)
            exit_code = allocation_exit_code(receipt, exit_code)
            operation_allocation_path.unlink(missing_ok=True)
        lifecycle = (
            load_json(operation_state)
            if operation_state is not None and operation_state.is_file()
            else {}
        )
        if (
            exit_code != 0
            and lifecycle.get("failure_code")
            in {"readiness_deadline_exceeded", "readiness_deadline_cleanup_failed", "capacity_unavailable"}
        ):
            exit_code = 75
        if managed_checkpoint:
            receipts = checkpoint_receipts(state_root, "operation")
            update_workspace_record(
                state_home=state_home,
                workspace_id=workspace_id,
                project=project,
                backend=backend,
                accelerator=accelerator,
                session=colab_session,
                receipts=receipts,
            )
        if (
            exit_code == 0
            and engine_target == "start"
            and BACKENDS[backend][0] == "yes"
            and backend != "host-ssh"
        ):
            print(
                "[cloudmake] subsequent targets reuse this resource until "
                "cloudmake --stop."
            )
        return exit_code

    run_id = uuid.uuid4().hex
    manifest_before = source_manifest_snapshot(state_root, backend)
    oci_before = oci_receipt_snapshot(state_root) if runner == "oci" else {}
    runs = state_root / "runs"
    allocation_path = (
        runs / f".{run_id}.allocation.json"
        if backend == "colab-notebook"
        else None
    )
    if allocation_path is not None:
        allocation_path.unlink(missing_ok=True)

    record_path = runs / f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-{run_id}.json"
    started_at = utc_timestamp()
    delivery_policy: dict[str, Any] = {"mode": "at-most-once", "max_attempts": 1}
    attempt: dict[str, Any] = {
        "ordinal": 1,
        "started_at": started_at,
        "target_submission": "not_submitted",
        "outcome": "running",
    }
    record: dict[str, Any] = {
        "schema": 1,
        "run_id": run_id,
        "cloudmake_version": VERSION,
        "project": os.fspath(project),
        "project_key": key,
        "backend": backend,
        "operation": "collect" if engine_target == "collect" else "execute",
        "target": remote_target,
        "assignments": assignment_receipts(assignments),
        "collect_directory": remote_collect_dir,
        "started_at": started_at,
        "status": "running",
        "phase": "target_submission",
        "provider_state": "unknown",
        "runtime_state": "local" if backend == "local" else "unknown",
        "session_created": False if backend == "local" else None,
        "preparation_state": "not_requested",
        "failure_code": None,
        "target_submission": "not_submitted",
        "retry_safe": True,
        "replay_safe": False,
        "target_semantic": {
            "idempotency": "asserted" if options["idempotent"] else "unknown",
            "scope": "invocation",
        },
        "delivery_policy": delivery_policy,
        "attempts": [attempt],
        "checkpoint": {"enabled": managed_checkpoint},
        "persistent_workspace": {
            "enabled": checkpoint,
            "mode": persistence_mode if checkpoint else "disabled",
            "workspace_id": workspace_id if managed_checkpoint else None,
        },
        "runner": {
            "kind": runner,
            "image": image if runner in {"oci", "devcontainer-native"} else None,
            "devices": devices if runner in {"oci", "devcontainer-native"} else [],
            "runtime_candidates": oci_runtimes if runner == "oci" else [],
            "devcontainer": (
                {
                    "path": devcontainer["path"],
                    "fingerprint": devcontainer["fingerprint"],
                    "engine": devcontainer.get("selected_engine"),
                    "required_capabilities": devcontainer["required_capabilities"],
                    "requirement_sources": devcontainer.get("requirement_sources", {}),
                    "adapter_capabilities": sorted(
                        backend_devcontainer_capabilities(backend, "adapter")
                    ),
                    "native_capabilities": sorted(
                        backend_devcontainer_capabilities(backend, "native")
                    ),
                    "host_requirements": devcontainer["host_requirements"],
                    "forward_ports": devcontainer["forward_ports"],
                    "environment_names": [
                        value.split("=", 1)[0]
                        for value in devcontainer["environment"]
                    ],
                }
                if devcontainer is not None
                else None
            ),
        },
    }
    if ssh_host is not None:
        record["host"] = ssh_host
    if gcp_resource is not None:
        record["compute_resource"] = {
            "provider": "gcp-compute",
            "project": gcp_resource["project"],
            "zone": gcp_resource["zone"],
            "instance": gcp_resource["instance"],
            "tunnel_through_iap": gcp_resource["tunnel_through_iap"] == "yes",
        }
    if retry_seconds is not None:
        record["allocation"] = {"attempts": 0, "outcome": "not-attempted"}
    atomic_json(record_path, record)
    operation_state = state_root / "operations" / f"{run_id}.json"
    local_target_exit_code: int | None = None
    try:
        if backend == "local":
            if runner == "native":
                print_local_execution_context(accelerator, accelerator_set)
                exit_code = local_make_command(
                    project=project,
                    target=remote_target,
                    assignments=assignments,
                    jobs=options["jobs"],
                    verbose=options["verbose"],
                )
                local_target_exit_code = exit_code
                runner_receipt: dict[str, Any] = {}
            elif runner == "oci":
                assert image is not None
                exit_code, runner_receipt = local_oci_command(
                    project=project,
                    image=image,
                    devices=devices,
                    oci_runtimes=oci_runtimes,
                    target=remote_target,
                    assignments=assignments,
                    jobs=options["jobs"],
                    state_root=state_root,
                    cache_home=cache_home,
                    run_id=run_id,
                    verbose=options["verbose"],
                    devcontainer=devcontainer,
                )
                local_target_exit_code = exit_code
                record["runner"].update(
                    {
                        name: runner_receipt[name]
                        for name in ("runtime", "digest", "image_inspection")
                        if name in runner_receipt
                    }
                )
            else:
                assert devcontainer is not None
                exit_code, runner_receipt = local_native_devcontainer_command(
                    project=project,
                    profile=devcontainer,
                    target=remote_target,
                    assignments=assignments,
                    jobs=options["jobs"],
                    state_root=state_root,
                    run_id=run_id,
                    verbose=options["verbose"],
                )
                local_target_exit_code = exit_code
                record["runner"].update(
                    {
                        name: runner_receipt[name]
                        for name in (
                            "runtime", "resolved_digest", "image_id", "platform", "container_id",
                            "preparation", "target_submission", "retry_safe", "status", "error",
                        )
                        if name in runner_receipt
                    }
                )
            if exit_code:
                if runner == "native" or runner_receipt.get("status") == "target-failed":
                    print(
                        f"[cloudmake] target {remote_target!r} failed with exit status "
                        f"{exit_code}",
                        file=sys.stderr,
                    )
            if exit_code == 0 and engine_target == "collect":
                exit_code = collect_local_artifacts(
                    project=project,
                    directory=remote_collect_dir,
                    state_root=state_root,
                    run_id=run_id,
                    verbose=options["verbose"],
                )
        else:
            exit_code = engine_command(
                project=project,
                backend=backend,
                accelerator=accelerator,
                accelerator_set=accelerator_set,
                ssh_host=ssh_host,
                jobs=options["jobs"],
                verbose=options["verbose"],
                state_home=state_home,
                cache_home=cache_home,
                key=key,
                workspace_id=workspace_id,
                adopt_from=adopt_from,
                target=engine_target,
                assignments=assignments,
                retry_seconds=retry_seconds,
                codespace=codespace,
                gcp_resource=gcp_resource,
                allocation_result=allocation_path,
                remote_target=remote_target,
                remote_collect_dir=remote_collect_dir,
                run_id=run_id,
                checkpoint=managed_checkpoint,
                native_persist=native_persist,
                colab_session=colab_session,
                operation_state=operation_state,
                runner=runner,
                image=image,
                devices=devices,
                oci_runtimes=oci_runtimes,
                devcontainer=devcontainer,
            )
    except BaseException:
        if allocation_path is not None:
            receipt = allocation_receipt(allocation_path)
            if receipt is not None:
                record["allocation"] = receipt
            allocation_path.unlink(missing_ok=True)
        if managed_checkpoint:
            record["checkpoint"]["operations"] = checkpoint_receipts(
                state_root, run_id
            )
            update_workspace_record(
                state_home=state_home,
                workspace_id=workspace_id,
                project=project,
                backend=backend,
                accelerator=accelerator,
                session=colab_session,
                receipts=record["checkpoint"]["operations"],
                update_owner=True,
            )
            clear_published_adoption(
                config_home, key, workspace_id, pending_adoption,
                record["checkpoint"]["operations"],
            )
        lifecycle = load_json(operation_state) if operation_state.is_file() else {}
        submission = lifecycle.get("target_submission", "ambiguous")
        if submission == "confirmed":
            submission = "submitted"
        if submission not in {"not_submitted", "submitted", "ambiguous"}:
            submission = "ambiguous"
        finished_at = utc_timestamp()
        attempt.update(
            finished_at=finished_at,
            target_submission=submission,
            outcome="interrupted",
        )
        record.update(
            status="interrupted",
            finished_at=finished_at,
            phase=lifecycle.get("phase", "target_execution"),
            provider_state=lifecycle.get("provider_state", "unknown"),
            runtime_state=lifecycle.get("runtime_state", record["runtime_state"]),
            session_created=lifecycle.get("session_created", record["session_created"]),
            preparation_state=lifecycle.get(
                "preparation_state", record["preparation_state"]
            ),
            failure_code=lifecycle.get("failure_code", "interrupted"),
            target_submission=submission,
            retry_safe=bool(lifecycle.get("retry_safe", False)),
            replay_safe=False,
        )
        atomic_json(record_path, record)
        atomic_json(runs / "latest.json", record)
        raise

    if allocation_path is not None:
        receipt = allocation_receipt(allocation_path)
        if receipt is not None:
            record["allocation"] = receipt
        exit_code = allocation_exit_code(receipt, exit_code)
        allocation_path.unlink(missing_ok=True)

    if managed_checkpoint:
        record["checkpoint"]["operations"] = checkpoint_receipts(state_root, run_id)
        record["persistent_workspace"]["operations"] = record["checkpoint"]["operations"]
        update_workspace_record(
            state_home=state_home,
            workspace_id=workspace_id,
            project=project,
            backend=backend,
            accelerator=accelerator,
            session=colab_session,
            receipts=record["checkpoint"]["operations"],
            update_owner=True,
        )
        clear_published_adoption(
            config_home, key, workspace_id, pending_adoption,
            record["checkpoint"]["operations"],
        )
    lifecycle = load_json(operation_state) if operation_state.is_file() else {}
    if (
        exit_code != 0
        and lifecycle.get("failure_code")
        in {"readiness_deadline_exceeded", "readiness_deadline_cleanup_failed", "capacity_unavailable"}
    ):
        exit_code = 75
    if backend == "local":
        resource_id, source = os.fspath(project), {"mode": "local-working-tree"}
    else:
        resource_id, source = newest_source_manifest(state_root, backend, manifest_before)
    if gcp_resource is not None:
        gcp_id = "--".join(
            (gcp_resource["project"], gcp_resource["zone"], gcp_resource["instance"])
        )
        observed = load_json(
            state_root / "gcp-compute-ssh" / gcp_id / "resource.json"
        )
        record["compute_resource"].update(
            {
                name: observed[name]
                for name in (
                    "resource_state",
                    "status",
                    "machine_type",
                    "accelerators",
                    "region",
                    "free_tier_compute_shape",
                    "billing_exposure",
                )
                if name in observed
            }
        )
    finished_at = utc_timestamp()
    if backend == "local":
        phase = (
            "artifact_retrieval"
            if engine_target == "collect"
            and local_target_exit_code == 0
            and exit_code != 0
            else "target_execution"
        )
        provider_state = "succeeded" if exit_code == 0 else "failed"
        runtime_state = "local"
        session_created: bool | None = False
        preparation_state = "not_requested"
        failure_code = (
            "artifact_collection_failed" if phase == "artifact_retrieval" else None
        )
        submission = "submitted"
        retry_safe = False
    else:
        phase = lifecycle.get("phase", "target_execution")
        provider_state = lifecycle.get(
            "provider_state", "succeeded" if exit_code == 0 else "unknown"
        )
        runtime_state = lifecycle.get("runtime_state", "unknown")
        session_created = lifecycle.get("session_created")
        preparation_state = lifecycle.get("preparation_state", "not_requested")
        failure_code = lifecycle.get("failure_code")
        submission = lifecycle.get(
            "target_submission", "submitted" if exit_code == 0 else "ambiguous"
        )
        if submission == "confirmed":
            submission = "submitted"
        if submission not in {"not_submitted", "submitted", "ambiguous"}:
            submission = "ambiguous"
        retry_safe = bool(lifecycle.get("retry_safe", False))

    if backend == "local":
        attempt_exit_code = local_target_exit_code
        attempt_outcome = (
            "succeeded" if local_target_exit_code == 0 else "target_failed"
        )
    elif phase == "artifact_retrieval" and submission == "submitted":
        attempt_exit_code = 0
        attempt_outcome = "succeeded"
    else:
        attempt_exit_code = exit_code if submission == "submitted" else None
        attempt_outcome = (
            "succeeded"
            if exit_code == 0
            else "target_failed"
            if submission == "submitted"
            else "not_submitted"
            if submission == "not_submitted"
            else "ambiguous"
        )
    attempt.update(
        finished_at=finished_at,
        target_submission=submission,
        outcome=attempt_outcome,
    )
    if attempt_exit_code is not None:
        attempt["exit_code"] = attempt_exit_code

    record.update(
        status=(
            "succeeded"
            if exit_code == 0
            else "interrupted" if exit_code in {130, 143} else "failed"
        ),
        exit_code=exit_code,
        finished_at=finished_at,
        resource_id=resource_id,
        source=source,
        phase=phase,
        provider_state=provider_state,
        runtime_state=runtime_state,
        session_created=session_created,
        preparation_state=preparation_state,
        failure_code=failure_code,
        target_submission=submission,
        retry_safe=retry_safe,
        replay_safe=False,
    )
    if lifecycle:
        record["lifecycle"] = lifecycle
    if runner == "oci":
        runner_receipt = newest_oci_receipt(state_root, oci_before)
        record["runner"].update(
            {
                name: runner_receipt[name]
                for name in ("runtime", "digest", "image_inspection", "status", "error")
                if name in runner_receipt
            }
        )
    if engine_target == "collect" and exit_code == 0:
        record["artifacts"] = artifact_receipt(collection_destination(project))
    atomic_json(record_path, record)
    atomic_json(runs / "latest.json", record)
    print(f"[cloudmake] run={run_id} provenance={record_path}")
    return exit_code


def main() -> int:
    try:
        return run(sys.argv[1:])
    except UsageError as error:
        print(f"cloudmake: {error}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("cloudmake: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
