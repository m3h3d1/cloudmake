        adapter_capabilities, native_capabilities = validate_backend_devcontainer_contract(name)
        devcontainer_engine = (
            "adapter+native"
            if adapter_capabilities and native_capabilities
            else "native" if native_capabilities
            else "adapter" if adapter_capabilities
