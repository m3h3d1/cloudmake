        )
        ports = "loopback" if "port-forward" in capabilities else "no"
        print(
            f"{name:22} {status:11} {session_reuse:13} {lifecycle:18} "
            f"{workspace:17} {'yes' if oci_native else 'no':10} {PERSISTENCE_MODES[name]:12} "
            f"{transport:36} {runtime_text:34} {internet_in:12} "
